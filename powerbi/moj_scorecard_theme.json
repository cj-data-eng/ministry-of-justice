    "callout": { "fontSize": 44, "fontFace": "Segoe UI Semibold", "color": "#12355B" },
    "title":   { "fontSize": 20, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "header":  { "fontSize": 16, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
